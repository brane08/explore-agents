# Template only — fill in and `oc apply -f` your own copy; never commit real
# values. `oc create secret generic orchestrator-secrets --from-literal=...`
# works just as well and avoids ever writing secrets to a file.
apiVersion: v1
kind: Secret
metadata:
  name: orchestrator-secrets
type: Opaque
stringData:
  ORCH_SECRET_KEY: "change-me"
  OPENAI_API_KEY: ""
  OPENAI_BASE_URL: ""
  ANTHROPIC_API_KEY: ""
