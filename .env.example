# agent-platform — environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and fill the CREDENTIALS / REAL-MODEL sections to flip the
# model-backed seams from deterministic stub to a real backend.
#
#   cp .env.example .env         # then edit .env (gitignored, never committed)
#   set -a && source .env && set +a   # load into the shell (code reads os.environ)
#
# Every value below is the code's own default (dataclass in config.py / seam
# selectors). With this file unedited, the full suite runs credential-free on
# the stubs — the defaults ARE the stub configuration.
# ---------------------------------------------------------------------------


# === SEAM SELECTORS =========================================================
# Flip these to the real backend once creds are set below.

# Routing / confirmation scorer + criteria-author seam (scoring.py).
#   stub      -> deterministic lexical_scorer (no creds)     [default]
#   anthropic -> real model call (needs ANTHROPIC_API_KEY)
#   openai    -> OpenAI / OpenAI-compatible chat-completions backend
#                (needs OPENAI_API_KEY[/OPENAI_BASE_URL]; uses httpx, no new dep).
# Unblocks: P1-residual R.1/R.2 (criteria-author), R.3 (threshold calibration).
ORCH_SCORER=stub
# Provider-neutral model id (holds a claude-* or an openai model id per provider).
ORCH_SCORER_MODEL=claude-haiku-4-5-20251001

# Role A / B2b dispatch harness seam (dispatch.py).
#   stub         -> deterministic PARTIAL-reporting double (no creds)  [default]
#   claude-cli   -> spawns `claude -p` in a write-restricted scratch workspace
#   openai-agent -> one structured completion returning the §6 file map, over
#                   any OpenAI-compatible endpoint (OpenRouter / local / OpenAI).
#                   Model supplies content only; the playbook fixes the layout,
#                   so every path it returns is validated into the scratch dir.
# Unblocks: Phase 2 real Role A generation (unit 2.30).
#
# NOTE: dispatch refuses any harness absent from <catalog_root>/conformance.yaml
# (CATALOG §10 — conformance is measured, never assumed). Run the layer-12
# conformance suite against this backend before it can generate a candidate.
ORCH_HARNESS=stub
# Generation model for openai-agent. Needs to be strong at long structured
# output — a weak local model will fail certify rather than produce something
# unsafe, but it will fail a lot. Namespaced ids work (openai/gpt-4o,
# anthropic/claude-3.5-sonnet, qwen2.5-coder:32b).
ORCH_HARNESS_MODEL=gpt-4o-mini
# Seconds for one generation call; local models on CPU need the headroom.
ORCH_HARNESS_TIMEOUT=600
# OpenRouter-only: pins the upstream provider(s) for ORCH_HARNESS_MODEL and
# disables fallback routing (comma-separated, first = primary). A bare model
# id on OpenRouter can be served by several providers running different
# quantizations of it (e.g. deepseek/deepseek-chat: fp4 on one, fp8 on
# another) — temperature=0 is only reproducible *within* one provider, so an
# unpinned id makes conformance results flaky across separate runs. Find
# providers for a model at openrouter.ai/api/v1/models/<id>/endpoints.
# Ignored (harmlessly) by non-OpenRouter OpenAI-compatible backends.
ORCH_HARNESS_PROVIDER=


# === CREDENTIALS ============================================================
# Required only when a seam above is set to a real backend. Read implicitly by
# the Anthropic SDK / the claude CLI — leave blank to stay on the stubs.
ANTHROPIC_API_KEY=

# OpenAI / OpenAI-compatible provider (for ORCH_SCORER=openai and the reserved
# certify models below). OPENAI_BASE_URL selects the endpoint; leave unset for
# api.openai.com. A key is mandatory ONLY against that default — set a base_url
# and the Authorization header is omitted, so keyless local servers work as-is.
#
#   OpenRouter    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                 OPENAI_API_KEY=sk-or-...
#                 model ids are namespaced: openai/gpt-4o-mini,
#                 anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-70b-instruct
#   ollama        OPENAI_BASE_URL=http://localhost:11434/v1   (no key)
#                 model ids carry a tag: llama3.1:8b, qwen2.5-coder:7b
#   llama.cpp     OPENAI_BASE_URL=http://localhost:8080/v1    (no key)
#   vLLM          OPENAI_BASE_URL=http://localhost:8000/v1    (no key)
#
# The certify model-diversity gate reads the family from the LAST path segment,
# so anthropic/claude-* is a claude-family judge — it cannot certify a
# claude-class implementation regardless of which gateway routed it.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Session signing key. CHANGE for anything beyond local dev.
ORCH_SECRET_KEY=dev-only-not-a-secret


# === CATALOG / PERSISTENCE ==================================================
ORCH_CATALOG_ROOT=.
# Defaults to <catalog_root>/orchestrator.sqlite3 when unset.
ORCH_DB_PATH=
# Playbook injected into Role A dispatch (data artifact; never edited by Role B).
ORCH_PLAYBOOK=docs/B2-agent-generation-playbook.md


# === ROUTING POLICY (calibration knobs) =====================================
ORCH_MATCH_THRESHOLD=0.35
# R.3: arbitrary until calibrated against a real scorer + labeled routing data.
ORCH_CONFIRM_THRESHOLD=0.5
ORCH_COVERAGE_THRESHOLD=0.15
# Resolver is Phase 4; pinned to the seeded stub profile for now.
ORCH_MODEL_PROFILE=stub-class-ref


# === AUTH / UI ==============================================================
# bff (gateway-trusted) XOR oidc. oidc is specced (UI-PLANE §7) but not built
# in Phase 1 — keep bff.
ORCH_AUTH_MODE=bff
# Comma-separated user ids allowed on meta screens (certify-queue, layer 10 §2.26).
ORCH_OPERATOR_USERS=


# === RESERVED ===============================================================
# Keys NOT yet read by code — reserved so the .env is stable across the builds
# that add them. Setting them today is a no-op. Provider-neutral: any value is
# a model id served by whichever provider the creds above select.

# Certify judge / eval / criteria-author models (Phase 2 steps 4 & 7 —
# units 2.14 eval, 2.20 diversity check, 2.23 security judge).
# CHECKLISTS layer 7 model-diversity rule: judge + criteria-author models MUST
# differ in family from the implementation profile — pick accordingly.
CERTIFY_EVAL_MODEL=
CERTIFY_JUDGE_MODEL=
CERTIFY_CRITERIA_MODEL=

# Router retrieval index — RAG over each entry's routing_summary
# (CATALOG §6 scale path). Off below ~500 entries: the whole lock is the
# router context today. When on, an embedding index does retrieval → shortlist
# → router prompt. Deferred; no vector store is wired yet.
ORCH_ROUTER_INDEX=off
ORCH_EMBED_MODEL=
