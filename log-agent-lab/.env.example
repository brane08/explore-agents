MOCK_LOG_API_URL=http://mock-log-api:8001
MCP_SERVER_URL=http://mcp-server:8000
ANTHROPIC_API_KEY=sk-ant-...

# --- b2a code-gen loop: LLM provider (all optional) ---
# Unset provider -> inferred from creds -> falls back to the no-key stub generator.
# B2A_LLM_PROVIDER=anthropic          # anthropic | openai
# B2A_MODEL=claude-opus-4-8           # model id for the chosen provider
# Any OpenAI-compatible server (OpenAI, Ollama, vLLM, LM Studio, OpenRouter, local):
# B2A_OPENAI_BASE_URL=http://localhost:11434/v1
# B2A_OPENAI_API_KEY=...

# Tool discovery: local skills directory (SKILL.md folders) is used first, so the
# loop works with no live MCP registry; live MCP list_tools() is the fallback.
# B2A_SKILLS_DIR=./skills
